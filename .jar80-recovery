#!/usr/bin/env bash
set -u

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

log() {
    printf '%s\n' "$*"
    logger -t rotom-nas-docker-recovery -- "$*"
}

die() {
    log "FAIL: $*"
    exit 1
}

ensure_nfs() {
    local path="$1"
    local escaped
    local unit

    escaped="$(systemd-escape --path "$path")" \
        || die "could not escape path $path"

    unit="${escaped}.mount"

    log "Ensuring NFS mount: $path ($unit)"

    systemctl start "$unit" \
        || die "could not start $unit"

    findmnt -M "$path" -t nfs,nfs4 --noheadings >/dev/null 2>&1 \
        || die "$path is not an active NFS mount"
}

recover_container() {
    local name="$1"
    local running
    local policy
    local error

    if ! docker inspect "$name" >/dev/null 2>&1; then
        log "$name: container absent; skipping"
        return 0
    fi

    running="$(docker inspect "$name" --format '{{.State.Running}}')"

    if [[ "$running" == "true" ]]; then
        log "$name: already running"
        return 0
    fi

    policy="$(docker inspect "$name" \
        --format '{{.HostConfig.RestartPolicy.Name}}')"

    if [[ "$policy" != "unless-stopped" && "$policy" != "always" ]]; then
        log "$name: stopped with restart policy '$policy'; leaving stopped"
        return 0
    fi

    error="$(docker inspect "$name" --format '{{.State.Error}}')"

    if [[ "$error" == *"/mnt/nas-"* ||
          "$error" == *"no such device"* ||
          "$error" == *"failed to fulfil mount request"* ||
          "$error" == *"error while creating mount source path"* ||
          "$error" == *"error mounting "* ]]; then

        log "$name: recovering prior NAS mount startup failure"

        docker start "$name" >/dev/null \
            || die "docker start failed for $name"

        sleep 2

        running="$(docker inspect "$name" --format '{{.State.Running}}')"

        [[ "$running" == "true" ]] \
            || die "$name did not remain running"

        log "$name: recovered"
    else
        log "$name: stopped without a NAS mount failure signature; leaving stopped"
    fi
}

log "NAS-backed Docker recovery check starting"

ensure_nfs /mnt/nas-downloaders
ensure_nfs /mnt/nas-media

[[ -d /mnt/nas-downloaders/torrents ]] \
    || die "Downloads torrents directory is missing"

[[ -d /mnt/nas-downloaders/.rotom-qbt-nas-ready ]] \
    || die "Downloads NAS-ready sentinel is missing"

[[ -d /mnt/nas-media/library ]] \
    || die "Media library directory is missing"

systemctl start \
    rotom-downloads-media-ro.service \
    || die "could not start Downloads bindfs service"

systemctl is-active --quiet rotom-downloads-media-ro.service \
    || die "Media bindfs service is not active"

findmnt -M /mnt/nas-downloads-media-ro \
    -t fuse,fuse.bindfs --noheadings >/dev/null 2>&1 \
    || die "Media bindfs view is not mounted"

runuser -u media -- test -r /mnt/nas-downloads-media-ro/torrents \
    || die "Media identity cannot traverse Downloads bindfs view"

recover_container qbittorrentvpn
recover_container radarr
recover_container sonarr
recover_container jellyfin

log "NAS-backed Docker recovery check completed successfully"
