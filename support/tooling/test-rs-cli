#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
RS="$REPO_ROOT/support/tooling/rs"
EXPECTED_REMOTE="git@github.com:jaredwines/rotom-support.git"
FIXTURE_ROOT="$(mktemp -d)"
REMOTE="$FIXTURE_ROOT/remote.git"
SEED="$FIXTURE_ROOT/seed"
CHECKOUT="$FIXTURE_ROOT/checkout"
CONFIG_ROOT="$FIXTURE_ROOT/config"
FAKE_SSH="$FIXTURE_ROOT/fake-ssh"
FAILURES=0

cleanup() {
    rm -rf "$FIXTURE_ROOT"
}
trap cleanup EXIT

pass() { printf 'PASS  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*" >&2; FAILURES=$((FAILURES + 1)); }

expect_success() {
    local label="$1"
    shift
    if "$@" >"$FIXTURE_ROOT/output" 2>&1; then
        pass "$label"
    else
        cat "$FIXTURE_ROOT/output" >&2
        fail "$label"
    fi
}

expect_failure() {
    local label="$1" pattern="$2"
    shift 2
    if "$@" >"$FIXTURE_ROOT/output" 2>&1; then
        cat "$FIXTURE_ROOT/output" >&2
        fail "$label (unexpected success)"
    elif grep -Fq -- "$pattern" "$FIXTURE_ROOT/output"; then
        pass "$label"
    else
        cat "$FIXTURE_ROOT/output" >&2
        fail "$label (missing expected error: $pattern)"
    fi
}

run_rr() {
    (
        cd "$FIXTURE_ROOT"
        env \
            XDG_CONFIG_HOME="$CONFIG_ROOT" \
            GIT_SSH_COMMAND="$FAKE_SSH" \
            "$RS" "$@"
    )
}

git init --bare "$REMOTE" >/dev/null
git init -b main "$SEED" >/dev/null
git -C "$SEED" config user.name "RS Fixture"
git -C "$SEED" config user.email "rs-fixture@example.invalid"
mkdir -p "$SEED/runbook"

for file in \
    00-Rotom-Change-Log.md 01-Rotom-Server-Inventory.md 02-Docker-Services.md \
    03-Network-and-Domains.md 04-NAS-and-Storage.md 05-Backup-and-Restore.md \
    06-Maintenance-and-Automation.md 07-Users-and-Permissions.md
do
    printf '# %s\n' "$file" >"$SEED/runbook/$file"
done
printf '# Directory Tree\n' >"$SEED/runbook/08-Rotom-Directory-Tree.txt"
printf '# Fixture instructions\n' >"$SEED/AGENTS.md"
printf '# Fixture readme\n' >"$SEED/README.md"

git -C "$SEED" add .
git -C "$SEED" commit -m "Seed RS fixture" >/dev/null
git -C "$SEED" remote add origin "$REMOTE"
git -C "$SEED" push -u origin main >/dev/null
git --git-dir="$REMOTE" symbolic-ref HEAD refs/heads/main
git clone "$REMOTE" "$CHECKOUT" >/dev/null 2>&1
git -C "$CHECKOUT" config user.name "RS Fixture"
git -C "$CHECKOUT" config user.email "rs-fixture@example.invalid"
git -C "$CHECKOUT" remote set-url origin "$EXPECTED_REMOTE"
{
    printf '#!/usr/bin/env bash\n'
    printf 'case "$*" in\n'
    printf '    *git-upload-pack*) exec git-upload-pack %q ;;\n' "$REMOTE"
    printf '    *git-receive-pack*) exec git-receive-pack %q ;;\n' "$REMOTE"
    printf '    *) exit 1 ;;\n'
    printf 'esac\n'
} >"$FAKE_SSH"
chmod 700 "$FAKE_SSH"
mkdir -p "$CONFIG_ROOT/rs"
printf '%s\n' "$CHECKOUT" >"$CONFIG_ROOT/rs/repository"

expect_success "rs help" run_rr help
expect_success "rs path resolves configured checkout" run_rr path
grep -Fxq "$CHECKOUT" "$FIXTURE_ROOT/output" && pass "rs path output" || fail "rs path output"
expect_success "rs status" run_rr status
expect_success "rs lint" run_rr lint
expect_success "rs check with isolated SSH transport" run_rr check

mkdir -p "$CONFIG_ROOT/rr"
printf '%s\n' "$CHECKOUT" >"$CONFIG_ROOT/rr/repository"
mv "$CONFIG_ROOT/rs/repository" "$CONFIG_ROOT/rs/repository.saved"
expect_success "rs resolves legacy configuration" run_rr path
mv "$CONFIG_ROOT/rs/repository.saved" "$CONFIG_ROOT/rs/repository"
printf '%s\n' "$FIXTURE_ROOT/missing" >"$CONFIG_ROOT/rr/repository"
expect_success "rs configuration takes precedence" run_rr path
run_wrapper() {
    (cd "$FIXTURE_ROOT" && env XDG_CONFIG_HOME="$CONFIG_ROOT" "$REPO_ROOT/support/tooling/rr" "$@")
}
expect_success "rr wrapper delegates to rs" run_wrapper path
grep -Fxq "$CHECKOUT" "$FIXTURE_ROOT/output" && pass "rr wrapper output" || fail "rr wrapper output"

printf 'dirty\n' >>"$CHECKOUT/README.md"
expect_failure "rs pull rejects dirty checkout" "Resolve or commit the local changes before continuing." run_rr pull
git -C "$CHECKOUT" restore README.md

git -C "$CHECKOUT" switch -c wrong-branch >/dev/null
expect_failure "rs rejects wrong branch" "Expected branch 'main'" run_rr path
git -C "$CHECKOUT" switch main >/dev/null

git -C "$CHECKOUT" remote set-url origin git@github.com:jaredwines/not-the-runbook.git
expect_failure "rs rejects wrong origin" "Unexpected origin remote" run_rr path
git -C "$CHECKOUT" remote set-url origin "$EXPECTED_REMOTE"

if run_rr unknown >"$FIXTURE_ROOT/output" 2>&1; then
    fail "rs unknown command exit code"
elif [[ "$?" -eq 2 ]]; then
    pass "rs unknown command exit code"
else
    fail "rs unknown command exit code"
fi

printf 'remote update\n' >>"$SEED/README.md"
git -C "$SEED" add README.md
git -C "$SEED" commit -m "Advance fixture remote" >/dev/null
git -C "$SEED" push origin main >/dev/null
expect_success "rs pull fast-forwards" run_rr pull
[[ "$(git -C "$CHECKOUT" rev-parse HEAD)" == "$(git --git-dir="$REMOTE" rev-parse main)" ]] && \
    pass "rs pull reached remote revision" || fail "rs pull reached remote revision"

printf 'local update\n' >>"$CHECKOUT/README.md"
expect_success "rs commit" run_rr commit "Exercise isolated commit"
[[ "$(git -C "$CHECKOUT" log -1 --pretty=%s)" == "Exercise isolated commit" ]] && \
    pass "rs commit message" || fail "rs commit message"
expect_success "rs push" run_rr push
[[ "$(git -C "$CHECKOUT" rev-parse HEAD)" == "$(git --git-dir="$REMOTE" rev-parse main)" ]] && \
    pass "rs push reached remote" || fail "rs push reached remote"

git -C "$SEED" fetch origin >/dev/null
git -C "$SEED" merge --ff-only origin/main >/dev/null
printf 'new remote update\n' >>"$SEED/README.md"
git -C "$SEED" add README.md
git -C "$SEED" commit -m "Advance fixture beyond checkout" >/dev/null
git -C "$SEED" push origin main >/dev/null
expect_failure "rs push rejects behind checkout" "is behind GitHub" run_rr push

if (( FAILURES > 0 )); then
    printf '\nRS CLI TESTS: FAIL (%d problem(s))\n' "$FAILURES" >&2
    exit 1
fi

printf '\nRS CLI TESTS: PASS\n'
